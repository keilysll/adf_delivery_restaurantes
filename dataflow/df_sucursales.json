{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "split2"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_sucursal = initCap(lower(nombre_sucursal)),",
				"          ciudad = initCap(lower(trim(ciudad))),",
				"          zona = initCap(lower(trim(zona)))\r",
				",",
				"          direccion = initCap(lower(trim(direccion)))) ~> derivedColumn1",
				"derivedColumn1 split(regexMatch(toString(capacidad_mesas), '^[0-9]+$'),",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido split(!isNull(direccion) && trim(direccion) != '',",
				"     disjoint: false) ~> split2@(validos, rechazados)",
				"split2@validos derive(capacidad_mesas = toShort(capacidad_mesas),",
				"          tiene_delivery = toBoolean(tiene_delivery)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}